# Copy to .env to override the docker-compose defaults.
# (docker compose reads .env automatically.)

# In-network Kafka bootstrap (used by the producer/parser/worker/api containers)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Host-facing Kafka bootstrap (used by local dev tooling on the machine running compose)
KAFKA_BOOTSTRAP_SERVERS_EXTERNAL=localhost:9093
DB_DSN=postgres://enron:enron@postgres:5432/enron?sslmode=disable
RAW_TOPIC=enron.raw
DLQ_TOPIC=enron.raw.dlq
WORKER_GRPC_ADDR=worker:50051
API_PORT=8080
# Host directory holding the unpacked Enron dataset (mounted read-only into the producer)
DATA_DIR_HOST=./data
